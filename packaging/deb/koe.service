[Unit]
Description=Koe - Japanese voice input for Ubuntu
After=graphical-session.target
PartOf=graphical-session.target
# Stop retrying when Koe keeps failing (e.g. no Whisper model downloaded yet)
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/koe
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
